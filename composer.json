{
    "name": "epicalgorithms/laravel-auth-sessions",
    "description": "Stateful session and device tracking for Laravel \u2014 models, middleware, and publishable views for platforms that need to know who is logged in where.",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Ozan Kurt",
            "email": "ozankurt@epicalgorithms.com",
            "homepage": "https://epicalgorithms.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/notifications": "^13.0",
        "epicalgorithms/laravel-enum-models": "^3.0",
        "epicalgorithms/laravel-api-kit": "^2.0",
        "ozankurt/agent": "^1.0.3"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "larastan/larastan": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "EpicAlgorithms\\AuthSessions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EpicAlgorithms\\AuthSessions\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://satis.epicalgorithms.dev"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "EpicAlgorithms\\AuthSessions\\AuthSessionsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
