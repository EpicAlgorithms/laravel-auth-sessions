{
    "name": "epicalgorithms/laravel-auth-sessions",
    "description": "Stateful session and device tracking for Laravel — models, middleware, and publishable views for platforms that need to know who is logged in where.",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Ozan Kurt",
            "email": "ozankurt@epicalgorithms.com",
            "homepage": "https://epicalgorithms.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/notifications": "^12.0|^13.0",
        "epicalgorithms/laravel-enum-models": "^1.1",
        "ozankurt/agent": "^1.0.3"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0|^12.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "EpicAlgorithms\\AuthSessions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EpicAlgorithms\\AuthSessions\\Tests\\": "tests/"
        }
    },
    "repositories": [
        { "type": "composer", "url": "https://satis.epicalgorithms.dev" }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "EpicAlgorithms\\AuthSessions\\AuthSessionsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
